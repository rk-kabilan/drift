// Windows resources for drift.exe: the app icon shown in Explorer, the taskbar and Alt+Tab.
// Paths are relative to the crate root, where build.rs runs the resource compiler.
1 ICON "assets/app-icon/windows/drift.ico"

// The name Windows shows for drift.exe (Task Manager, file properties, "Open with").
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Drift"
      VALUE "FileDescription", "Drift"
      VALUE "ProductName", "Drift"
      VALUE "InternalName", "drift"
      VALUE "OriginalFilename", "drift.exe"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
