// Windows resources for drift.exe: the app icon shown in Explorer, the taskbar and Alt+Tab.
// A template: build.rs fills in the icon path and the version from Cargo.toml.
1 ICON "@ICON@"

// The name Windows shows for drift.exe (Task Manager, file properties, "Open with").
1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Drift"
      VALUE "FileDescription", "Drift"
      VALUE "ProductName", "Drift"
      VALUE "InternalName", "drift"
      VALUE "OriginalFilename", "drift.exe"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
